[Desktop Entry]
Type=Service
MimeType=application/pdf;
Actions=MosaicoPDFWizard;MosaicoPDFQuickCarta;MosaicoPDFQuickA4;
X-KDE-Priority=TopLevel

[Desktop Action MosaicoPDFWizard]
Name=Dividir/Escalar con MosaicoPDF (Asistente)
Icon=document-print
Exec=__RIGHTCLICK_BIN__ %f

[Desktop Action MosaicoPDFQuickCarta]
Name=MosaicoPDF rapido (Carta, solapa 12mm, mapa)
Icon=document-print
Exec=__MOSAICOPDF_BIN__ %f --papel carta --solapa 12mm --mapa

[Desktop Action MosaicoPDFQuickA4]
Name=MosaicoPDF rapido (A4, solapa 12mm, mapa)
Icon=document-print
Exec=__MOSAICOPDF_BIN__ %f --papel a4 --solapa 12mm --mapa
